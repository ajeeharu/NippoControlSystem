<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 10 Windows ターゲット指定 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>

    <!-- プロジェクト・アセンブリ設定 -->
    <RootNamespace>wChecker</RootNamespace>
    <AssemblyName>NewNippo</AssemblyName>
    <StartupObject>wChecker.Program</StartupObject>

    <!-- Windows Forms 有効化 -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- プラットフォーム指定 (x86で固定する場合) -->
    <PlatformTarget>x86</PlatformTarget>

    <!-- AssemblyInfo の重複生成を防ぐ設定 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- SYSLIB0011 を一時的に無視（リソースや古いシリアライザが含まれるため） -->
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
    <NoWarn>$(NoWarn);SYSLIB0051</NoWarn>
    <Platforms>AnyCPU;x86</Platforms>
    <Configurations>Debug;Release;DEVICE_DEBUG</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- デザイナー・DataSet 関連の設定 -->
    <Compile Update="DataSetTopMenu.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DataSetTopMenu.xsd</DependentUpon>
    </Compile>
    <Compile Update="DLLSource\Cyc.Forms.NumericTextBox\Cyc.Forms.NumericTextBox2\ClickAbleButton.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="DLLSource\Cyc.Forms.NumericTextBox\Cyc.Forms.NumericTextBox2\NumericTextBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="DLLSource\Cyc.Forms.NumericTextBox\Cyc.Forms.NumericTextBox2\SwitchLabel.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="DLLSource\Cyc.Forms.NumericTextBox\Cyc.Forms.NumericTextBox2\SwitchLabel2.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="DataSetItems.cs">
      <DependentUpon>DataSetItems.xsd</DependentUpon>
    </Compile>
    <Compile Update="DataSetTopMenu.cs">
      <DependentUpon>DataSetTopMenu.xsd</DependentUpon>
    </Compile>
    <None Update="DataSetItems.xsc">
      <DependentUpon>DataSetItems.xsd</DependentUpon>
    </None>
    <None Update="DataSetItems.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DataSetItems2.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </None>
    <None Update="DataSetItems.xss">
      <DependentUpon>DataSetItems.xsd</DependentUpon>
    </None>
    <None Update="DataSetTopMenu.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DataSetTopMenu.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </None>
    <None Update="DataSetTopMenu.xsc">
      <DependentUpon>DataSetTopMenu.xsd</DependentUpon>
    </None>
    <None Update="DataSetTopMenu.xss">
      <DependentUpon>DataSetTopMenu.xsd</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 他の PackageReference と並べて追記 -->
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- ThirdParty フォルダ内の cdio.dll caio.dll をビルド出力先へ自動コピー -->
    <None Include="ThirdParty\cdio.dll">
      <Link>cdio.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="ThirdParty\caio.dll">
      <Link>caio.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>