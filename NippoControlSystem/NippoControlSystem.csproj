<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <EnableTestingPlatformBuilder>false</EnableTestingPlatformBuilder>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <!-- 既存の AssemblyInfo.cs を優先するため、自動生成を無効化 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 既存の設定に SYSLIB0051 を追加 (複数ある場合はセミコロン区切り) -->
    <NoWarn>$(NoWarn);SYSLIB0051</NoWarn>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Infrastructure\NativeLibs\caio.dll" />
    <None Remove="Infrastructure\NativeLibs\cdio.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ApplicationService\Dtos\" />
    <Folder Include="ApplicationService\Scenarios\" />
    <Folder Include="Domain\Models\" />
    <Folder Include="Infrastructure\Mocks\" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
    <!-- ThirdPartyの cdio.dll caio.dll をビルド出力先へ自動コピー -->
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Infrastructure\Persistence\DataSetItems.designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DataSetItems.xsd</DependentUpon>
    </Compile>
    <Compile Update="UI\Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="UI\Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Infrastructure\Persistence\DataSetItems.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DataSetItems.designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Infrastructure/NativeLibs 内のすべての .dll をビルド時に bin の直下にコピー -->
    <Content Include="Infrastructure\NativeLibs\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
